# ==============================================================================
# Supporto AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Core Django Settings
DEBUG=True
SECRET_KEY=supporto-ai-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=127.0.0.1,localhost

# Local AI Engine Settings (Apple Silicon / CPU / CUDA)
AI_ENABLED=True
MODEL_LLM_PATH=models/llm/Qwen3-8B-Q4_K_M.gguf
MODEL_STT_PATH=models/stt/whisper-small
MODEL_TTS_PATH=models/tts/kokoro

# Google OAuth & Gmail Mailbox Integration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/integrations/gmail/callback/

# Symmetric Encryption Key for Token Storage (Auto-generated if empty)
ENCRYPTION_KEY=

